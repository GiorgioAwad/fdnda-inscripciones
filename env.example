# Copia este archivo a .env y completa los valores.

# Nivel del despliegue. En serverless NODE_ENV siempre vale "production", así
# que el entorno real y el de pruebas se distinguen aquí.
#   sin definir  -> producción: exige Izipay real, registro del banco de datos
#                   personales y PAYMENTS_MODE=izipay.
#   staging      -> admite el sandbox de Izipay y PAYMENTS_MODE=mock, y no pide
#                   el registro del banco de datos.
# Solo el valor exacto "staging" relaja los controles: olvidarla deja el
# comportamiento estricto. Un despliegue con APP_ENV=staging NUNCA debe apuntar
# a la base de producción.
# APP_ENV=staging

DATABASE_URL="postgresql://postgres:admin@localhost:5432/fdnda_inscripciones"
# Producción serverless: DATABASE_URL debe ser el endpoint pooled de Neon
# (-pooler, sslmode=require). Migraciones/backups usan la conexión directa.
#
# DIRECT_DATABASE_URL no se carga en el hosting web: solo la leen las
# migraciones, y llevarla allí daría a la aplicación credenciales con permisos
# de DDL. El runtime arranca sin ella a propósito.
DIRECT_DATABASE_URL="postgresql://postgres:admin@localhost:5432/fdnda_inscripciones"
DATABASE_POOL_MAX=2
PRISMA_MIGRATE_SHADOW_DATABASE_URL="postgresql://postgres:admin@localhost:5432/fdnda_inscripciones_shadow"

# Solo para una base local/descartable. Habilita prisma/seed.ts, que contiene
# datos y claves DEMO. No definir en staging ni producción.
# DEMO_SEED_CONFIRM=SEED_FDNDA_DEMO
# DEMO_ADMIN_PASSWORD=
# DEMO_REGATAS_PASSWORD=
# DEMO_TERRAZAS_PASSWORD=

# El importador maestro exige una URL separada para evitar que --apply use por
# accidente DATABASE_URL. Definir únicamente durante la operación autorizada.
# IMPORT_DATABASE_URL="postgresql://postgres:admin@localhost:5432/fdnda_inscripciones"

# Genera uno con: npx auth secret  (o cualquier string aleatorio largo)
AUTH_SECRET=""
AUTH_TRUST_HOST=true
# Obligatoria si hay más de una instancia. Base64 de 32 bytes, compartida por
# todas las instancias y estable durante despliegues graduales.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# mock = pagos simulados (desarrollo). izipay = pasarela real.
# NUNCA usar mock apuntando a una base de datos de producción.
PAYMENTS_MODE=mock

# Credenciales Izipay Web Core (developers.izipay.pe)
IZIPAY_MERCHANT_CODE=
IZIPAY_API_KEY=
IZIPAY_HASH_KEY=
IZIPAY_PUBLIC_KEY=
IZIPAY_ENDPOINT=https://sandbox-api-pw.izipay.pe
# IZIPAY_ENDPOINT=https://api-pw.izipay.pe   # producción

# Opcionales de Izipay (tienen valor por defecto en el código):
# NEXT_PUBLIC_IZIPAY_PUBLIC_KEY   — respaldo de IZIPAY_PUBLIC_KEY
# IZIPAY_CHECKOUT_SCRIPT_URL      — se deriva de IZIPAY_ENDPOINT (sandbox vs prod)
# IZIPAY_FALLBACK_EMAIL           — correo del comprador si el club no tiene uno válido

# Dominio público. Alimenta el IPN y las URLs de retorno que recibe Izipay: el
# IPN es servidor-a-servidor, así que con localhost nunca llega. Para probar en
# local levanta un túnel (ver docs/IZIPAY_PRUEBAS.md) y pon aquí su URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Host del túnel de desarrollo (sin protocolo), p.ej. abc123.ngrok-free.app.
# Sin esto Next bloquea sus recursos de dev y las server actions por cross-origin.
DEV_TUNNEL_HOST=

# Secreto usado por el programador que ejecuta cada minuto:
# POST /api/internal/maintenance/expire-orders
MAINTENANCE_SECRET=

# Solo en Vercel: su cron manda "Authorization: Bearer <CRON_SECRET>". Debe
# valer exactamente lo mismo que MAINTENANCE_SECRET o el endpoint responderá
# 401 y las órdenes dejarán de expirar. Ver docs/VERCEL_DEPLOYMENT.md.
CRON_SECRET=

# HMAC para no guardar IP en claro en rate limits/auditoría.
IP_HASH_SECRET=

# La app no arranca en producción sin estos datos legales.
PRIVACY_CONTACT_EMAIL=privacidad@fdnda.pe
PERSONAL_DATA_BANK_REGISTRATION_CODE=

# Opcional: receptor HTTPS de eventos de error sanitizados (Sentry relay,
# Better Stack, Datadog, etc.).
ERROR_REPORTING_WEBHOOK_URL=
