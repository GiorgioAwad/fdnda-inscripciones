{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fdnda-production-maintenance",
  "account_id": "4670d3f9ab3a0e40e7285bc9fc714e50",
  "main": "src/index.js",
  "compatibility_date": "2026-09-28",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "secrets": {
    "required": ["APP_ORIGIN", "MAINTENANCE_SECRET"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}